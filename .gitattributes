# Auto-detect text files and normalize line endings to LF for Windows <-> Mac sync
* text=auto eol=lf

# Unity & Code text files
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.wav binary
*.ogg binary
*.mp3 binary
*.fbx binary
*.obj binary
*.blend binary
*.ttf binary
*.otf binary
*.cubemap binary
*.lighting binary
*.exr binary
*.hdr binary
